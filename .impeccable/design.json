  "narrative": {
    "northStar": "Munich '72 Program",
    "overview": "Training, eating and body are three disciplines, each owning one flat colour (blue, green, orange) in the manner of Otl Aicher's 1972 Olympic identity. Every movement pattern has a geometric pictogram. Neutrals are cool silver and deep blue-black; no black UI, gradient, glass or card shadow. Hairline modules on a 4px grid, 12px working radius. Light by default, dark for night sessions.",
    "keyCharacteristics": [
      "Discipline colour is the only chroma",
      "ExerciseMark pictogram beside every exercise name",
      "Hairline modules, flat at rest",
      "Condensed tabular numerals via num",
      "Fixed chart scales, fixed set columns, stamped set states",
      "AI is neutral ink"
    ],
    "rules": [
      {
        "name": "The Three Disciplines Rule",
        "body": "A screen takes its chroma from its discipline and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Ink-for-AI Rule",
        "body": "AI actions are bg-ink text-canvas, AI panels bg-sunken, Sparkles icon. No purple.",
        "section": "colors"
      },
      {
        "name": "The Soft Pairing Rule",
        "body": "-soft tints pair only with the matching -ink text; solid fills pair with text-on-accent.",
        "section": "colors"
      },
      {
        "name": "The Num Rule",
        "body": "Every weight, rep count, kcal, macro, timer and date number uses num.",
        "section": "typography"
      },
      {
        "name": "The Sentence-Case Rule",
        "body": "No small uppercase tracked eyebrows above headings.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Hairline plus tone, not shadow. Cards are never nested.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic token utilities only.",
      "Do keep touch targets at least 44px.",
      "Do put ExerciseMark beside every exercise name.",
      "Do use num on every number.",
      "Do stamp completed sets and keep skipped sets visible.",
      "Do keep chart y-axis scales fixed per metric."
    ],
    "donts": [
      "Don't use raw palette classes, hex or dark: variants.",
      "Don't use gradients, glass or backdrop-blur.",
      "Don't nest cards.",
      "Don't add uppercase tracked eyebrows.",
      "Don't colour AI features purple or with a discipline colour.",
      "Don't add your own backdrop to a Modal."
    ]
  }
